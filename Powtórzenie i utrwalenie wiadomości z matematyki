
<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101b34">
<title>Powtórzenie i utrwalenie wiadomości z matematyki</title>

<!-- MATHJAX -->
<script>
window.MathJax = {
  tex: {
    inlineMath: [['\\(','\\)'],['$','$']],
    displayMath: [['\\[','\\]'],['$$','$$']]
  },
  svg: {fontCache:'global'}
};
</script>
<script defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>

<!-- FONTS -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">

<style>
/* ===================================
   KOLORY I TYPOGRAFIA
=================================== */
:root {
  --navy:#101b34;
  --blue:#596aea;
  --violet:#7965ed;
  --mint:#20b99f;
  --bg:#f6f8fc;
  --text:#23324b;
  --muted:#65758f;
  --border:#e2e9f4;
  --good:#087d66;
  --bad:#cd4663;
  --shadow:0 14px 38px rgba(20,35,77,.08);
}

* {box-sizing:border-box}

html {
  scroll-behavior:smooth;
  scroll-padding-top:120px;
}

body {
  margin:0;
  font-family:Manrope,Arial,sans-serif;
  font-size:22px;
  line-height:1.8;
  color:var(--text);
  background:
    radial-gradient(circle at 90% 3%,#eae8ff,transparent 25%),
    radial-gradient(circle at 4% 17%,#e5f8f2,transparent 23%),
    var(--bg);
}

h1,h2,h3 {
  font-family:Outfit,Manrope,Arial,sans-serif;
  letter-spacing:-.035em;
  line-height:1.2;
}

h2 {
  margin:0;
  font-size:clamp(2.25rem,3.8vw,3.2rem);
  color:var(--navy);
}

h3 {
  margin:10px 0 17px;
  font-size:1.68rem;
  color:var(--navy);
}

p {margin:.7em 0}

button,input,select {font:inherit}

button {
  cursor:pointer;
  transition:transform .2s,box-shadow .2s;
}

button:hover:not(:disabled) {
  transform:translateY(-2px);
}

button:disabled {
  opacity:.6;
  cursor:not-allowed;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible {
  outline:3px solid var(--mint);
  outline-offset:3px;
}

input,select {
  min-width:0;
  max-width:100%;
  padding:15px 17px;
  border:1.5px solid #d4ddec;
  border-radius:13px;
  background:white;
  color:var(--text);
  font-size:1.05rem;
}

mjx-container {
  max-width:100%;
  overflow-x:auto;
  overflow-y:hidden;
}

/* ===================================
   HERO
=================================== */
.hero {
  position:relative;
  min-height:530px;
  display:grid;
  grid-template-columns:1.35fr .65fr;
  align-items:center;
  gap:36px;
  padding:75px max(5vw,24px);
  overflow:hidden;
  color:white;
  background:
    radial-gradient(circle at 85% 18%,#7371c562,transparent 36%),
    linear-gradient(125deg,#101b34,#263d72 65%,#484399);
}

.hero::before {
  content:"";
  position:absolute;
  right:-165px;
  top:-215px;
  width:450px;
  height:450px;
  border:1px solid #ffffff34;
  border-radius:50%;
  box-shadow:0 0 0 75px #ffffff09,
             0 0 0 150px #ffffff05;
}

.hero-copy,.hero-art {
  position:relative;
  z-index:1;
}

.eyebrow {
  display:inline-flex;
  padding:11px 18px;
  border:1px solid #ffffff39;
  border-radius:99px;
  background:#ffffff15;
  font-size:.95rem;
  font-weight:800;
  letter-spacing:.05em;
}

.hero h1 {
  margin:25px 0;
  font-size:clamp(2.55rem,4.5vw,5rem);
  line-height:1.1;
  letter-spacing:-.05em;
}

.hero h1 span {color:#a2ecdc}

.hero p {
  max-width:770px;
  color:#e0ebff;
  font-size:1.22rem;
  line-height:1.8;
}

.hero-badges {
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin:28px 0;
}

.hero-badges span {
  padding:11px 16px;
  border:1px solid #ffffff31;
  border-radius:99px;
  background:#ffffff13;
  font-size:1rem;
  font-weight:800;
}

.hero-actions {
  display:flex;
  flex-wrap:wrap;
  gap:13px;
  margin-top:29px;
}

.hero-actions a {
  padding:16px 24px;
  border-radius:14px;
  font-size:1.08rem;
  font-weight:800;
  text-decoration:none;
}

.hero-primary {
  background:white;
  color:var(--navy);
}

.hero-secondary {
  border:1px solid #ffffff80;
  color:white;
}

.hero-art {
  display:grid;
  place-items:center;
  min-height:300px;
}

.orbit {
  width:min(310px,100%);
  aspect-ratio:1;
  display:grid;
  place-items:center;
  border:2px dashed #ffffff47;
  border-radius:50%;
  animation:float 5s ease-in-out infinite;
}

.orbit-card {
  width:235px;
  min-height:190px;
  padding:22px;
  display:grid;
  justify-items:center;
  align-content:center;
  gap:10px;
  border-radius:26px;
  background:white;
  color:var(--navy);
  text-align:center;
  box-shadow:0 25px 52px #050b254c;
  transform:rotate(-5deg);
}

.orbit-card strong {
  font-family:Georgia,serif;
  font-size:4.4rem;
  line-height:1;
  color:var(--violet);
}

.orbit-card b {font-size:1.2rem}

.orbit-card small {
  color:var(--muted);
  font-size:.92rem;
}

/* ===================================
   MENU
=================================== */
nav {
  position:sticky;
  top:0;
  z-index:50;
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:8px;
  padding:12px 3vw;
  background:#ffffffef;
  border-bottom:1px solid var(--border);
  box-shadow:0 8px 24px #101b3409;
  backdrop-filter:blur(16px);
}

nav a,nav button {
  padding:12px 15px;
  border:0;
  border-radius:11px;
  background:transparent;
  color:var(--navy);
  font-size:1.1rem;
  font-weight:800;
  white-space:nowrap;
  text-decoration:none;
}

nav a:hover,nav button:hover {
  transform:none;
  background:#eef0ff;
}

nav a.active {
  background:var(--navy);
  color:white;
}

nav button {
  background:#e3f8f0;
  color:#087762;
}

/* ===================================
   UKŁAD STRONY
=================================== */
main {
  width:min(1360px,94vw);
  margin:auto;
  padding:38px 0 110px;
}

section {
  margin:58px 0 85px;
  scroll-margin-top:120px;
}

.section-title {
  display:flex;
  align-items:center;
  gap:19px;
  margin-bottom:30px;
}

.section-icon {
  display:grid;
  place-items:center;
  flex:0 0 74px;
  width:74px;
  height:74px;
  border-radius:22px;
  color:white;
  font-size:2.15rem;
  background:linear-gradient(135deg,var(--blue),var(--violet));
  box-shadow:0 12px 25px #596aea35;
}

.small {
  color:var(--muted);
  font-size:1.14rem;
}

.card-grid,.visual-grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(315px,1fr));
  gap:24px;
}

.card,.panel {
  min-width:0;
  padding:30px;
  background:white;
  border:1px solid var(--border);
  border-radius:25px;
  box-shadow:var(--shadow);
}

.card {
  transition:transform .25s,box-shadow .25s;
}

.card:hover {
  transform:translateY(-4px);
  box-shadow:0 22px 46px #101b341b;
}

/* ===================================
   TEORIA
=================================== */
.theory-card {
  position:relative;
  overflow:hidden;
}

.theory-card::before {
  content:"";
  position:absolute;
  inset:0 0 auto;
  height:5px;
  background:linear-gradient(90deg,var(--mint),var(--violet));
}

.theory-card p {
  font-size:1.2rem;
  line-height:1.85;
}

.topic-number {
  display:inline-grid;
  place-items:center;
  min-width:44px;
  height:44px;
  padding:0 11px;
  border-radius:12px;
  background:#eeebff;
  color:#5e4cc2;
  font-weight:800;
}

.formula {
  margin:20px 0;
  padding:23px 15px;
  border:1px solid #e5e9f9;
  border-radius:17px;
  background:linear-gradient(125deg,#f0f3ff,#ecfaf7);
  font-size:1.42rem;
  text-align:center;
  overflow-x:auto;
}

/* ===================================
   ILUSTRACJE SVG + LATEX
=================================== */
.visual {
  min-width:0;
  overflow:hidden;
  border:1px solid var(--border);
  border-radius:28px;
  background:white;
  box-shadow:var(--shadow);
  transition:transform .25s,box-shadow .25s;
}

.visual:hover {
  transform:translateY(-5px);
  box-shadow:0 24px 48px #101b3420;
}

.visual-canvas {
  position:relative;
  width:100%;
  aspect-ratio:600/350;
  overflow:hidden;
  isolation:isolate;
}

/* Tylko SVG tła */
.visual-canvas > svg {
  position:absolute;
  inset:0;
  z-index:0;
  display:block;
  width:100%;
  height:100%;
}

/* SVG generowany przez MathJax zachowuje rozmiar */
.visual-canvas .math-pin mjx-container {
  position:static!important;
  display:inline-block!important;
  width:auto!important;
  height:auto!important;
  max-width:none!important;
  margin:0!important;
  padding:0!important;
  overflow:visible!important;
  vertical-align:middle!important;
  color:inherit!important;
}

.visual-canvas .math-pin mjx-container > svg {
  position:static!important;
  inset:auto!important;
  display:inline-block!important;
  width:auto!important;
  height:auto!important;
  max-width:none!important;
  overflow:visible!important;
}

.art-title {
  position:absolute;
  z-index:2;
  top:4%;
  left:5%;
  width:90%;
  text-align:center;
  font-size:clamp(17px,2vw,29px);
  font-weight:800;
  color:#293c67;
  pointer-events:none;
}

.math-pin {
  position:absolute;
  z-index:5;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:max-content;
  max-width:92%;
  transform:translate(-50%,-50%);
  color:#253a62;
  font-size:clamp(15px,2vw,27px);
  line-height:1;
  white-space:nowrap;
  pointer-events:none;
}

.math-pin.small-math {
  font-size:clamp(13px,1.55vw,21px);
}

.math-pin.large-math {
  font-size:clamp(16px,2.3vw,31px);
}

.math-pin.purple {color:#614bc6}
.math-pin.green {color:#087763}
.math-pin.brown {color:#8b5628}
.math-pin.white {color:white}

.visual .caption {
  min-height:130px;
  padding:27px 29px;
  border-top:1px solid #e6ebf4;
  color:#52617b;
  font-size:1.23rem;
  line-height:1.8;
}

.visual .caption b {color:#273b60}

/* ===================================
   PRZYCISKI I ZADANIA
=================================== */
.control-row {
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:13px;
  margin:21px 0;
}

.primary,.secondary,.success {
  padding:16px 23px;
  border:0;
  border-radius:14px;
  font-size:1.16rem;
  font-weight:800;
}

.primary {
  color:white;
  background:linear-gradient(135deg,var(--blue),var(--violet));
  box-shadow:0 7px 18px #596aea30;
}

.secondary {
  background:#edf1f8;
  color:#344762;
}

.success {
  color:#087663;
  background:#d9f7eb;
}

.exercise,.quiz-question {
  margin:18px 0;
  padding:27px;
  border:1px solid var(--border);
  border-radius:20px;
  background:white;
  font-size:1.2rem;
  line-height:1.85;
}

.exercise .num {
  display:inline-grid;
  place-items:center;
  min-width:45px;
  height:45px;
  margin-right:12px;
  padding:0 10px;
  border-radius:12px;
  background:linear-gradient(135deg,var(--blue),var(--violet));
  color:white;
  font-weight:800;
}

.answerline {
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:12px;
  margin-top:18px;
}

.answerline input {flex:1 1 190px}

.feedback {
  min-height:28px;
  margin-top:13px;
  font-size:1.1rem;
  font-weight:800;
}

.good {color:var(--good)}
.bad {color:var(--bad)}

/* ===================================
   GRY
=================================== */
.game-board {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(120px,1fr));
  gap:12px;
}

.memory {
  min-height:120px;
  padding:13px;
  border:1px solid #6655c9;
  border-radius:17px;
  background:linear-gradient(145deg,#342c81,#7661e7);
  color:white;
  font-size:1.2rem;
  font-weight:800;
}

.memory.revealed {
  background:white;
  border:2px solid #b9b0fa;
  color:var(--navy);
}

.memory.matched {
  background:#d9f8eb;
  border:2px solid #75dcbb;
  color:#087761;
}

/* ===================================
   BANK ZADAŃ
=================================== */
.task-columns {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(330px,1fr));
  gap:20px;
  align-items:start;
}

.topic-group {
  padding:26px;
  background:white;
  border:1px solid var(--border);
  border-radius:21px;
  box-shadow:var(--shadow);
}

.topic-group summary {
  cursor:pointer;
  font-weight:800;
  font-size:1.28rem;
  color:var(--navy);
}

.topic-group[open] summary {margin-bottom:17px}

.source-task {
  margin:13px 0;
  padding:20px;
  border-left:4px solid var(--violet);
  border-radius:14px;
  background:#f8faff;
  font-size:1.2rem;
  overflow-x:auto;
}

/* ===================================
   TEST
=================================== */
.progress-shell {
  width:100%;
  height:15px;
  overflow:hidden;
  background:#e7ecf5;
  border-radius:99px;
}

.progress-bar {
  width:0;
  height:100%;
  background:linear-gradient(90deg,var(--mint),var(--blue),var(--violet));
  transition:width .35s;
}

.quiz-question label {
  display:flex;
  align-items:center;
  gap:13px;
  margin:11px 0;
  padding:17px 19px;
  background:#f7f9fd;
  border:1px solid transparent;
  border-radius:14px;
  cursor:pointer;
  font-size:1.2rem;
}

.quiz-question label:hover {background:#eef0ff}

.quiz-question label:has(input:checked) {
  background:#eeebff;
  border-color:#b9aff4;
}

.quiz-question input {accent-color:var(--violet)}

.quiz-question.correct {border-color:#8cdec5}
.quiz-question.incorrect {border-color:#f2b0be}

/* ===================================
   PRACA DOMOWA
=================================== */
.homework-sheet {
  padding:35px;
  background:white;
  border:1px solid #dedcf7;
  border-radius:24px;
  box-shadow:var(--shadow);
}

.hw-item {
  padding:21px 0;
  border-bottom:1px solid #e9edf5;
  break-inside:avoid;
  font-size:1.2rem;
}

.hw-space {
  height:65px;
  margin-top:14px;
  border-bottom:1px dashed #bbc7d8;
}

footer {
  padding:50px 5vw;
  background:var(--navy);
  color:#cbd8ed;
  text-align:center;
  font-size:1.1rem;
}

footer b {color:white}

/* ===================================
   MOBILE
=================================== */
@keyframes float {
  0%,100% {transform:translateY(0)}
  50% {transform:translateY(-8px)}
}

@media(max-width:950px) {
  .hero {grid-template-columns:1fr}
}

@media(max-width:620px) {
  body {font-size:19px}

  .hero {
    min-height:auto;
    padding:43px 22px;
  }

  .hero h1 {
    font-size:clamp(2.1rem,9.3vw,3.5rem);
  }

  .hero p {font-size:1.08rem}
  .hero-art {min-height:250px}
  .orbit {max-width:235px}
  .orbit-card {width:185px;min-height:145px}

  nav {
    justify-content:flex-start;
    flex-wrap:nowrap;
    overflow-x:auto;
    scrollbar-width:none;
    padding:11px;
  }

  nav a,nav button {
    flex:0 0 auto;
    font-size:1rem;
  }

  main {width:calc(100% - 28px)}
  section {margin:38px 0 55px}

  h2 {font-size:2rem}
  h3 {font-size:1.4rem}

  .small {font-size:1.02rem}

  .section-icon {
    flex:0 0 52px;
    width:52px;
    height:52px;
    font-size:1.45rem;
  }

  .card-grid,.visual-grid,.task-columns {
    grid-template-columns:minmax(0,1fr);
  }

  .card,.panel,.topic-group {padding:20px}

  .theory-card p {font-size:1.08rem}
  .formula {font-size:1.18rem}

  .visual .caption {
    min-height:auto;
    padding:20px;
    font-size:1.08rem;
  }

  .art-title {font-size:clamp(16px,4.2vw,23px)}
  .math-pin {font-size:16px}
  .math-pin.small-math {font-size:13px}
  .math-pin.large-math {font-size:19px}

  .game-board {
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  #searchTask,#topicFilter {width:100%}

  .primary,.secondary,.success {
    font-size:1.05rem;
  }

  .exercise,.quiz-question,.source-task,.hw-item {
    font-size:1.08rem;
  }
}

@media(prefers-reduced-motion:reduce) {
  *,*::before,*::after {
    animation:none!important;
    transition:none!important;
    scroll-behavior:auto!important;
  }
}

/* ===================================
   PRINT
=================================== */
@media print {
  @page {size:A4;margin:13mm}

  nav,.no-print,.hero-art,button {
    display:none!important;
  }

  body {
    background:white!important;
    color:black;
    font-size:12pt;
  }

  main {width:100%;padding:0}

  .hero {
    min-height:auto;
    padding:12px;
    background:white!important;
    color:black!important;
  }

  .hero h1,.hero p {color:black!important}

  .card,.panel,.visual,.exercise,
  .quiz-question,.source-task,.homework-sheet {
    box-shadow:none!important;
    break-inside:avoid;
  }

  body.print-homework .hero,
  body.print-homework nav,
  body.print-homework footer,
  body.print-homework main>section:not(#homework),
  body.print-homework #homework .section-title,
  body.print-homework #homework>.control-row {
    display:none!important;
  }

  body.print-homework #homework {margin:0}

  body.print-homework #homeworkSheet {
    border:0;
    padding:0;
    box-shadow:none;
  }
}
</style>
</head>

<body>

<!-- ===================================
   NAGŁÓWEK
=================================== -->
<header class="hero" id="top">

  <div class="hero-copy">

    <span class="eyebrow">
      ✦ LEKCJA POWTÓRZENIOWA · MATEMATYKA
    </span>

    <h1>
      Powtórzenie i utrwalenie<br>
      <span>wiadomości z matematyki</span>
    </h1>

    <p>
      Lekcja powtórzeniowa obejmująca liczby,
      ułamki, podzielność, potęgi, wyrażenia
      algebraiczne, równania, proporcje,
      procenty i zadania tekstowe.
      Powtórz teorię, wykonaj ćwiczenia
      i sprawdź swoje umiejętności.
    </p>

    <div class="hero-badges">
      <span>📘 Teoria</span>
      <span>🪄 Ilustracje</span>
      <span>🎯 Trening</span>
      <span>🎮 Gry</span>
      <span>🏆 Sprawdzian</span>
    </div>

    <div class="hero-actions">
      <a class="hero-primary" href="#trainer">
        Rozpocznij ćwiczenia
      </a>
      <a class="hero-secondary" href="#theory">
        Powtórz teorię
      </a>
    </div>

  </div>

  <div class="hero-art" aria-hidden="true">
    <div class="orbit">
      <div class="orbit-card">
        <strong>π</strong>
        <b>Powtórzenie wiedzy</b>
        <small>Teoria · Ćwiczenia · Test</small>
      </div>
    </div>
  </div>

</header>

<nav aria-label="Nawigacja lekcji">
  <a href="#theory">📘 Teoria</a>
  <a href="#visuals">🪄 Ilustracje</a>
  <a href="#trainer">🎯 Trening</a>
  <a href="#games">🎮 Gry</a>
  <a href="#bank">🗂 Zadania</a>
  <a href="#test">🏆 Sprawdzian</a>
  <a href="#homework">🏠 Praca domowa</a>
  <button type="button" onclick="printAll()">🖨 Drukuj</button>
</nav>

<main>

<!-- TEORIA -->
<section id="theory">
  <div class="section-title">
    <div class="section-icon">📘</div>
    <div>
      <h2>Powtórzenie teorii</h2>
      <div class="small">
        Najważniejsze zasady, wzory i przykłady.
