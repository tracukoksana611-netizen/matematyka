let quizLocked=false;

function renderQuiz() {
  quizLocked=false;

  const box=document.getElementById("quizContainer");

  box.innerHTML=quiz.map((q,i)=>`
    <div class="quiz-question" id="quizQ${i}">
      <h3>${i+1}. ${q.q}</h3>

      ${q.options.map((v,j)=>`
        <label>
          <input type="radio"
                 name="quiz${i}"
                 value="${j}"
                 onchange="updateQuizProgress()">
          <span>${inline(v.replace(".", "{,}"))}</span>
        </label>
      `).join("")}

      <div id="quizFb${i}" class="feedback"></div>
    </div>
  `).join("");

  document.getElementById("quizResult").textContent="";
  document.getElementById("quizProgress").style.width="0%";

  typesetMath([box]);
}

function updateQuizProgress() {
  const answered=quiz.filter((_,i)=>
    document.querySelector(`input[name="quiz${i}"]:checked`)
  ).length;

  document.getElementById("quizProgress").style.width=
    (answered/quiz.length*100)+"%";
}

function checkQuiz() {
  if(quizLocked) return;

  let score=0;
  const feedbackNodes=[];

  quiz.forEach((q,i)=>{
    const selected=document.querySelector(
      `input[name="quiz${i}"]:checked`
    );

    const correct=!!selected&&
      Number(selected.value)===q.answer;

    if(correct) score++;

    const fb=document.getElementById("quizFb"+i);

    fb.innerHTML=(correct?"✓ ":"✗ ")+q.explanation;
    fb.className="feedback "+(correct?"good":"bad");

    feedbackNodes.push(fb);

    document.getElementById("quizQ"+i)
      .classList.add(correct?"correct":"incorrect");
  });

  document.querySelectorAll("#quizContainer input")
    .forEach(x=>x.disabled=true);

  quizLocked=true;

  const percent=Math.round(score/quiz.length*100);

  const message=percent>=90
    ?"🏆 Znakomicie!"
    :percent>=70
    ?"👏 Bardzo dobrze!"
    :percent>=50
    ?"👍 Dobry początek!"
    :"📘 Powtórz materiał.";

  document.getElementById("quizResult").textContent=
    `${message} Wynik: ${score}/${quiz.length} (${percent}%).`;

  document.getElementById("quizProgress").style.width="100%";

  typesetMath(feedbackNodes);
}

function resetQuiz() {
  renderQuiz();
}

