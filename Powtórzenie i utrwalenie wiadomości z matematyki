let divGame=null;
let divScore=0;
let divRounds=0;

function newDivGame() {
  const divisors=[2,3,5,9,10];
  const d=divisors[Math.floor(Math.random()*divisors.length)];

  const good=d*(2+Math.floor(Math.random()*40));
  const wrong=new Set();

  while(wrong.size<3) {
    const n=10+Math.floor(Math.random()*400);
    if(n%d!==0&&n!==good) wrong.add(n);
  }

  divGame={d,good,done:false};

  const question=document.getElementById("divQuestion");

  question.innerHTML=
    "Która liczba jest podzielna przez "+
    inline(String(d))+"?";

  const choices=document.getElementById("divChoices");

  choices.innerHTML=shuffle([good,...wrong])
    .map(n=>`
      <button class="secondary" onclick="checkDiv(${n})">
        ${inline(String(n))}
      </button>
    `).join("");

  const fb=document.getElementById("divFeedback");
  fb.textContent="";
  fb.className="feedback";

  typesetMath([question,choices]);
}

function checkDiv(n) {
  if(!divGame||divGame.done) return;

  divGame.done=true;
  divRounds++;

  const correct=n===divGame.good;
  if(correct) divScore++;

  document.querySelectorAll("#divChoices button")
    .forEach(b=>b.disabled=true);

  const fb=document.getElementById("divFeedback");

  fb.innerHTML=
    (correct
      ?"✓ Dobrze!"
      :"✗ Poprawna liczba: "+inline(String(divGame.good))+".")
    +` Wynik: ${divScore}/${divRounds}`;

  fb.className="feedback "+(correct?"good":"bad");

  typesetMath([fb]);
}

