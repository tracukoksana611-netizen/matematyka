function setupBank() {
  const select=document.getElementById("topicFilter");

  select.innerHTML=
    '<option value="">Wszystkie tematy</option>';

  Object.keys(topics).forEach(topic=>{
    const option=document.createElement("option");
    option.value=topic;
    option.textContent=topic;
    select.appendChild(option);
  });

  renderBank();
}

function renderBank() {
  const query=document.getElementById("searchTask")
    .value.trim().toLocaleLowerCase("pl");

  const selected=document.getElementById("topicFilter").value;
  const box=document.getElementById("bankContainer");
  let html="";

  Object.entries(topics).forEach(([topic,tasks])=>{
    if(selected&&selected!==topic) return;

    const matching=tasks.filter(task=>
      !query||(topic+" "+task)
        .toLocaleLowerCase("pl")
        .includes(query)
    );

    if(!matching.length) return;

    html+=`
      <details class="topic-group" ${query?"open":""}>
        <summary>
          ${escapeHTML(topic)} (${matching.length})
        </summary>
        ${matching.map((t,i)=>`
          <div class="source-task">
            <b>${i+1}.</b> ${t}
          </div>
        `).join("")}
      </details>
    `;
  });

  box.innerHTML=html||
    '<div class="panel">Nie znaleziono zadań.</div>';

  typesetMath([box]);
}

function setAllDetails(open) {
  document.querySelectorAll("#bankContainer details")
    .forEach(d=>d.open=open);
}

