function checkTraining(i) {
  const raw=document.getElementById("train"+i)
    .value.trim();

  const fb=document.getElementById("trainFb"+i);

  if(!raw) {
    fb.textContent="Wpisz odpowiedź.";
    fb.className="feedback bad";
    return;
  }

  const x=numeric(raw);
  const y=numeric(training[i].a);

  const correct=Number.isFinite(x)&&
    Number.isFinite(y)&&
    Math.abs(x-y)<1e-8;

  trainingResults[i]=correct;

  fb.textContent=correct
    ?"✓ Poprawna odpowiedź!"
    :"✗ Sprawdź obliczenia i spróbuj ponownie.";

  fb.className="feedback "+(correct?"good":"bad");

  updateTrainingScore();
}

