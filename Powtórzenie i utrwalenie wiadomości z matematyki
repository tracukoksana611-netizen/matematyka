const memoryPairs=[
  [String.raw`2^3`,String.raw`8`],
  [String.raw`3^2`,String.raw`9`],
  [String.raw`5^2`,String.raw`25`],
  [String.raw`7\cdot6`,String.raw`42`],
  [String.raw`\operatorname{NWD}(12,18)`,String.raw`6`],
  [String.raw`10\%\ \text{z}\ 70`,String.raw`7`],
  [String.raw`3^3`,String.raw`27`],
  [String.raw`4^2`,String.raw`16`]
];

let memoryCards=[];
let openedCards=[];
let memoryLocked=false;
let matched=0;
let moves=0;
let memoryGeneration=0;

function startMemory() {
  memoryGeneration++;

  memoryCards=shuffle(memoryPairs.flatMap((p,id)=>[
    {id,tex:p[0],open:false,matched:false},
    {id,tex:p[1],open:false,matched:false}
  ]));

  openedCards=[];
  memoryLocked=false;
  matched=0;
  moves=0;

  renderMemory();
  updateMemoryStatus();
}

function renderMemory() {
  const board=document.getElementById("memoryBoard");

  board.innerHTML=memoryCards.map((c,i)=>`
    <button class="memory
      ${c.open?"revealed":""}
      ${c.matched?"matched":""}"
      onclick="flipMemory(${i})"
      ${c.matched?"disabled":""}>
      ${c.open||c.matched?inline(c.tex):"✦"}
    </button>
  `).join("");

  typesetMath([board]);
}

function updateMemoryStatus() {
  document.getElementById("memoryStatus")
    .textContent=
    `Pary: ${matched}/${memoryPairs.length} · Ruchy: ${moves}`;
}

function flipMemory(i) {
  if(memoryLocked||
     memoryCards[i].open||
     memoryCards[i].matched) return;

  memoryCards[i].open=true;
  openedCards.push(i);
  renderMemory();

  if(openedCards.length!==2) return;

  moves++;
  const [a,b]=openedCards;

  if(memoryCards[a].id===memoryCards[b].id) {
    memoryCards[a].matched=true;
    memoryCards[b].matched=true;

    matched++;
    openedCards=[];

    renderMemory();
    updateMemoryStatus();

    if(matched===memoryPairs.length) {
      document.getElementById("memoryStatus")
        .textContent=`🏆 Wygrana! Ruchy: ${moves}`;
    }
  } else {
    memoryLocked=true;
    const generation=memoryGeneration;

    setTimeout(()=>{
      if(generation!==memoryGeneration) return;

      memoryCards[a].open=false;
      memoryCards[b].open=false;
      openedCards=[];
      memoryLocked=false;

      renderMemory();
      updateMemoryStatus();
    },900);
  }
}

